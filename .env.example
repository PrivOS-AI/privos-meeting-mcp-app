# Copy to .env for local settings. Runtime mode is auto-detected
# (@privos_ai/app-server resolveRuntimeMode), never set by env:
#   managed                — the platform mounts a workload socket (PRIVOS_WORKLOAD_SOCKET).
#   standalone-production   — a paired identity file exists (`npm run pair`).
#   development             — neither is present and NODE_ENV is not production.

# --- Development (relay transport, `npm run dev`) ---
# Filled in by the pairing prompt on first run and reused on every `npm run dev`.
# PRIVOS_URL=http://localhost:3000
# CLIENT_ID=
# CLIENT_SECRET=
# mcpAppId the Hub assigned this install — required for bot tool-calls in dev.
# Cached by the dev pairing loop from the SAME pairing response.
# MCP_APP_ID=

# Serve the UI from an in-process Vite dev server (HMR) instead of an inlined
# bundle. PUBLIC_URL must be reachable by the browser rendering the Hub.
# PRIVOS_DEV_UI=1
# VITE_PORT=5179
# PUBLIC_URL=http://localhost:5179

# --- Standalone production ---
# PRIVOS_STANDALONE_IDENTITY_FILE=./privos-standalone-identity.json
# PORT=3012

# --- Listen port (verified free on hodao) ---
# PORT=3012

# --- Agent bot credential (installation bot; required for all backend Hub access) ---
# A workspace admin issues/rotates these from Admin > Apps > this app > Settings.
# The bot must have joined the room to write Files (meeting_bootstrap joins it).
# PRIVOS_AGENT_BOT_USER_ID=
# PRIVOS_AGENT_BOT_CREDENTIAL=
# Dev-only escape hatch: allow tool calls with an unverified actor. Never honoured
# in production (NODE_ENV=production always fails closed).
# ALLOW_UNVERIFIED_ACTOR=1

# --- Speech-to-text providers (at least one key required; the SELECTED provider must have its key) ---
# STT_REALTIME_PROVIDER=soniox
# STT_ASYNC_PROVIDER=soniox
# SONIOX_API_KEY=
# ELEVENLABS_API_KEY=
# SONIOX_RT_MODEL=stt-rt-v5
# SONIOX_ASYNC_MODEL=stt-async-v5
# ELEVENLABS_REALTIME_MODEL=scribe_v2_realtime
# ELEVENLABS_BATCH_MODEL=scribe_v2
# ELEVENLABS_DIARIZATION_THRESHOLD=0.22
# SONIOX_TEMP_KEY_TTL_SEC=900
# LIVE_MAX_CONCURRENT_RECORDINGS=8
# LIVE_UPLOAD_RETRY_WINDOW_MIN=15

# --- Speaker embedding / voiceprint ---
# SPEAKER_MODEL_PATH=models/3dspeaker_speaker-embedding_advanced.onnx
# SPEAKER_MATCH_THRESHOLD=0.5
# SPEAKER_MIN_SEGMENT_SEC=2
# SPEAKER_ENROL_TARGET_SEC=25
# SPEAKER_SESSION_MATCH_THRESHOLD=0.40
# SPEAKER_SESSION_MERGE_THRESHOLD=0.60
# LIVE_MIN_SPEECH_SEC=8
# LIVE_CHUNK_OVERLAP_SEC=8
# AES-256-GCM 32-byte key, base64. LOSING THIS KEY = LOSING ALL VOICEPRINTS. Back it up.
# VOICEPRINT_ENC_KEY=

# --- Hub AI summary + presigned Files origin ---
# SUMMARY_MODEL=
# Origin of presigned Files downloads — declared in the manifest CSP connect-src/media-src.
# PRIVOS_FILES_ORIGIN=
# MEETING_DATA_DIR=./data
# MEETING_JOB_CONCURRENCY=1
# MEETING_JOB_TIMEOUT_MS=3600000
